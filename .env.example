# Copie para .env (que não vai para o Git) e ajuste.

# Obrigatório para a API subir: mínimo de 32 caracteres.
# Gere um com: openssl rand -base64 48
JWT_SECRET=

POSTGRES_PASSWORD=taskflow

# Portas no host (padrão da spec: 3000 e 8080).
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5436

# Observabilidade (docker compose --profile observability up -d)
GRAFANA_PASSWORD=
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
