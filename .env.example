# Copie para .env (que não vai para o Git) e ajuste.

# Obrigatório para a API subir: mínimo de 32 caracteres.
# Gere um com: openssl rand -base64 48
JWT_SECRET=

POSTGRES_PASSWORD=taskflow

# Portas no host (padrão da spec: 3000 e 8080).
WEB_PORT=3000
API_PORT=8080
POSTGRES_PORT=5436

# Observabilidade (docker compose --profile observability up -d)
GRAFANA_PASSWORD=

# Anexos: Local (padrão, volume Docker) ou S3 (sobe o SeaweedFS com: docker compose --profile s3 up -d).
STORAGE_PROVIDER=Local
S3_ACCESS_KEY=taskflow
S3_SECRET_KEY=
S3_PORT=8333

# Antivírus nos anexos: vazio = desligado; clamav = ligado (docker compose --profile antivirus up -d).
ANTIVIRUS_HOST=
CLAMAV_PORT=3310

# Espaço de anexos por projeto, em MB.
PROJECT_QUOTA_MB=100
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
